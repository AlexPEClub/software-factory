#!/usr/bin/env bash
# Runs the mandatory checks from .factory/setup.json on the current commit and writes the result
# to /work/verify.json and /work/verify.md (verify.md in the project language, FACTORY_LANGUAGE).
# The runner only accepts a build if verify.json is green and matches the pushed commit.
#
#   factory-verify            (run in the repo folder, without uncommitted changes)
set -uo pipefail

WORKDIR="${FACTORY_WORK:-/work}"
cd "${1:-$WORKDIR/repo}"
if [ -n "$(git status --porcelain)" ]; then
  echo "There are uncommitted changes. Commit and push first, then verify." >&2
  exit 2
fi
if [ ! -f .factory/setup.json ]; then
  echo "No .factory/setup.json found. Create it (install + checks) and commit it." >&2
  exit 2
fi

# Read the checks strictly: valid JSON and at least one check, otherwise nothing is verified
if ! CHECKS=$(jq -er '.checks | select(type == "object") | to_entries | map(select((.value | type) == "string" and (.value | length) > 0)) | select(length > 0) | .[] | [.key, .value] | @tsv' .factory/setup.json 2>/dev/null); then
  echo ".factory/setup.json is invalid or contains no checks (\"checks\": {\"name\": \"command\"}). Without checks nothing counts as verified." >&2
  exit 2
fi

# Table for the PR in the project language: German for de-*, English otherwise
case "$(printf '%s' "${FACTORY_LANGUAGE:-de}" | cut -d- -f1 | tr '[:upper:]' '[:lower:]')" in
  de) T_TITLE="Checks auf Commit"; T_HEAD="| Check | Befehl | Ergebnis |" ;;
  *)  T_TITLE="Checks on commit"; T_HEAD="| Check | Command | Result |" ;;
esac

SHA=$(git rev-parse HEAD)
RESULTS="[]"; FAILED=0
MD="$T_HEAD\n|---|---|---|\n"
while IFS=$'\t' read -r NAME CMD; do
  [ -z "$NAME" ] && continue
  echo "▶ $NAME: $CMD"
  OUT=$(bash -lc "$CMD" </dev/null 2>&1); CODE=$?
  TAIL=$(printf "%s" "$OUT" | tail -n 25)
  if [ $CODE -eq 0 ]; then echo "  ✓ passed"; ICON="✅"; else echo "  ✗ failed (exit $CODE)"; printf "%s\n" "$TAIL"; ICON="❌ Exit $CODE"; FAILED=1; fi
  MD+="| $NAME | \`$CMD\` | $ICON |\n"
  RESULTS=$(jq --arg n "$NAME" --arg c "$CMD" --argjson e $CODE --arg t "$TAIL" '. + [{name:$n, cmd:$c, exit:$e, tail:$t}]' <<<"$RESULTS")
done <<< "$CHECKS"

jq -n --arg sha "$SHA" --argjson r "$RESULTS" --argjson ok $([ $FAILED -eq 0 ] && echo true || echo false) \
  '{sha:$sha, ok:$ok, results:$r, at:(now|todate)}' > "$WORKDIR/verify.json"
printf "**$T_TITLE \`%s\`**\n\n$MD" "${SHA:0:7}" > "$WORKDIR/verify.md"
echo; [ $FAILED -eq 0 ] && echo "All checks passed on ${SHA:0:7}." || echo "At least one check failed."
exit $FAILED
